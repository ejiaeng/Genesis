<node id="Machpelah">
  <data key="d0">Machpelah</data>
  <data key="d1">location</data>
  <data key="d2">Machpelah is a cave and burial place where Abraham and Sarah were buried.&lt;SEP&gt;Machpelah is the cave and burial property in Canaan where Joseph's father was buried.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-023&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-054</data>
