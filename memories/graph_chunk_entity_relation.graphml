<node id="Anah">
  <data key="d0">Anah</data>
  <data key="d1">person</data>
  <data key="d2">Anah is Zibeon's child, a Horite chief, and the father of Dishon and Aholibamah.&lt;SEP&gt;The parent of Aholibamah and the child of Zibeon.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-036&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-037</data>
