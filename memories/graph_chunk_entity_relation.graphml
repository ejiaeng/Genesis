  <data key="d0">Bozrah</data>
  <data key="d1">location</data>
  <data key="d2">Bozrah is the place associated with Zerah, Jobab's father.&lt;SEP&gt;Bozrah was the place associated with Zerah.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-037&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-038</data>
