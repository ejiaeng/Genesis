<node id="Herdmen Of Lot">
  <data key="d0">Herdmen Of Lot</data>
  <data key="d1">organization</data>
  <data key="d2">The herdsmen responsible for Lot's cattle who engage in strife with Abram's herdsmen.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-010</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121376</data>
  <data key="d6"></data>
</node>
<node id="Plain of Mamre">
  <data key="d0">Plain of Mamre</data>
  <data key="d1">location</data>
  <data key="d2">A plain where Abram dwelt after moving his tent and where Abram was confederate with Mamre, Eshcol, and Aner.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-011</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121376</data>
  <data key="d6"></data>
</node>
<node id="Hebron">
  <data key="d0">Hebron</data>
  <data key="d1">location</data>
  <data key="d2">A place associated with the plain of Mamre, where Abram dwelt.&lt;SEP&gt;Hebron was the identification given for Kirjatharba in the land of Canaan.&lt;SEP&gt;Hebron is identified as Mamre and is located in the land of Canaan.&lt;SEP&gt;The city also called Arbah where Abraham and Isaac sojourned and where Jacob visited Isaac.&lt;SEP&gt;Hebron was the vale from which Israel sent Joseph toward Shechem.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-011&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-019&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-020&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-036&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-038</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121376</data>
  <data key="d6"></data>
</node>
<node id="Amraphel">
  <data key="d0">Amraphel</data>
  <data key="d1">person</data>
  <data key="d2">A king of Shinar who joined Chedorlaomer and other kings in war against the kings of the vale of Siddim.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-011</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121376</data>
  <data key="d6"></data>
</node>
<node id="Arioch">
  <data key="d0">Arioch</data>
  <data key="d1">person</data>
  <data key="d2">A king of Ellasar who joined Chedorlaomer and other kings in war.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-011</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121376</data>
  <data key="d6"></data>
</node>
<node id="Ellasar">
  <data key="d0">Ellasar</data>
  <data key="d1">location</data>
  <data key="d2">The territory ruled by Arioch.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-011</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121376</data>
