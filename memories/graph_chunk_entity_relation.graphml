<node id="Vision">
  <data key="d0">Vision</data>
  <data key="d1">event</data>
  <data key="d2">The vision is the setting in which the word of the LORD comes to Abram with reassurance and promises.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-012</data>
  <data key="d4">Book 01        Genesis.md</data>
