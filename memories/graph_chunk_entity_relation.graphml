</node>
<node id="Elon">
  <data key="d0">Elon</data>
  <data key="d1">person</data>
  <data key="d2">Bashemath's father, identified as a Hittite.&lt;SEP&gt;A Hittite and the father of Adah.&lt;SEP&gt;Elon is a son of Zebulun.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-025&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-036&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-049</data>
