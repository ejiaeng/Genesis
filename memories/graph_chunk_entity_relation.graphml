  <data key="d0">Ephrath</data>
  <data key="d1">location</data>
  <data key="d2">The place near which Rachel died and was buried, identified with Bethlehem.&lt;SEP&gt;Ephrath is the place near which Rachel died and was buried.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-036&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-052</data>
