  <data key="d0">Tower Of Edar</data>
  <data key="d1">location</data>
  <data key="d2">A landmark beyond which Israel spread his tent.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-036</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121392</data>
  <data key="d6"></data>
</node>
<node id="Aholibamah">
  <data key="d0">Aholibamah</data>
  <data key="d1">person</data>
  <data key="d2">A daughter of Anah and a wife of Esau who bore Jeush, Jaalam, and Korah.&lt;SEP&gt;Aholibamah is Esau's wife and the mother of Jeush, Jaalam, and Korah.&lt;SEP&gt;Aholibamah was identified as one of the dukes of Edom descended from Esau.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-036&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-037&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-038</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121392</data>
  <data key="d6"></data>
</node>
<node id="Eliphaz">
  <data key="d0">Eliphaz</data>
  <data key="d1">person</data>
  <data key="d2">A son of Esau and Adah.&lt;SEP&gt;Eliphaz is Esau's son by Adah and the father of Amalek and several named chiefs.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-036&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-037</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121392</data>
  <data key="d6"></data>
</node>
<node id="Reuel">
  <data key="d0">Reuel</data>
  <data key="d1">person</data>
  <data key="d2">A son of Esau and Bashemath.&lt;SEP&gt;Reuel is Esau's son by Bashemath and the ancestor of named Edomite chiefs.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-036&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-037</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121392</data>
  <data key="d6"></data>
</node>
<node id="Korah">
  <data key="d0">Korah</data>
  <data key="d1">person</data>
  <data key="d2">A son of Esau and Aholibamah.&lt;SEP&gt;Korah is Aholibamah's son and an Edomite chief associated with Eliphaz's line.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-036&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-037</data>
