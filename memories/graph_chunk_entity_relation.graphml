  <data key="d1">person</data>
  <data key="d2">Keturah is Abraham's wife and the mother of Zimran, Jokshan, Medan, Midian, Ishbak, and Shuah.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-023</data>
