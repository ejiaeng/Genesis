  <data key="d0">Hezron</data>
  <data key="d1">person</data>
  <data key="d2">Hezron is a son of Reuben and a son of Pharez.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-049</data>
