<node id="Living Creature">
  <data key="d0">Living Creature</data>
  <data key="d1">creature</data>
  <data key="d2">A broad category including fowl, cattle, beasts, and every creature included in God's covenant.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-007</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Fishes of the Sea">
  <data key="d0">Fishes of the Sea</data>
  <data key="d1">creature</data>
  <data key="d2">Fish placed under human authority and included among the living creatures covered by God's covenant.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-007</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Cloud">
  <data key="d0">Cloud</data>
  <data key="d1">naturalobject</data>
  <data key="d2">A visible atmospheric formation in which the covenant bow appears as a sign of God's covenant.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-007</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Garment">
  <data key="d0">Garment</data>
  <data key="d1">artifact</data>
  <data key="d2">A covering used by Shem and Japheth to cover Noah's nakedness.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-007</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Tent">
  <data key="d0">Tent</data>
  <data key="d1">artifact</data>
  <data key="d2">A dwelling place associated with Noah and the tents in which Japheth is said to dwell with Shem.&lt;SEP&gt;A dwelling used by Abram and Lot during their journeys and settlements.&lt;SEP&gt;A dwelling Isaac pitched at Beersheba.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-007&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-010&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-025</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Nimrod">
  <data key="d0">Nimrod</data>
  <data key="d1">person</data>
  <data key="d2">Nimrod is described as a mighty hunter and the founder of a kingdom beginning with Babel, Erech, Accad, and Calneh.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-008</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Asshur">
  <data key="d0">Asshur</data>
  <data key="d1">person</data>
  <data key="d2">Asshur is identified as a child of Shem and as the builder of Nineveh, Rehoboth, and Calah.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-008</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Sidon">
  <data key="d0">Sidon</data>
  <data key="d1">location</data>
  <data key="d2">Sidon is identified as the firstborn of Canaan and as a boundary point of the Canaanites.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-008</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Eber">
  <data key="d0">Eber</data>
  <data key="d1">person</data>
  <data key="d2">Eber is identified as a child of Shem and the father of Peleg and Joktan.&lt;SEP&gt;A descendant of Salah who begat Peleg and later had additional sons and daughters.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-008&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-009</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Arphaxad">
  <data key="d0">Arphaxad</data>
  <data key="d1">person</data>
  <data key="d2">Arphaxad is identified as a child of Shem and the father of Salah.&lt;SEP&gt;A descendant of Shem who begat Salah and later had additional sons and daughters.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-008&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-009</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Salah">
  <data key="d0">Salah</data>
  <data key="d1">person</data>
  <data key="d2">Salah is identified as the child of Arphaxad and the father of Eber.&lt;SEP&gt;A descendant of Arphaxad who begat Eber and later had additional sons and daughters.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-008&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-009</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Peleg">
  <data key="d0">Peleg</data>
  <data key="d1">person</data>
  <data key="d2">Peleg is identified as a son of Eber, during whose days the earth was divided.&lt;SEP&gt;A descendant of Eber who begat Reu and later had additional sons and daughters.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-008&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-009</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Joktan">
  <data key="d0">Joktan</data>
  <data key="d1">person</data>
  <data key="d2">Joktan is identified as a son of Eber and the father of Almodad, Sheleph, Hazarmaveth, Jerah, Hadoram, Uzal, Diklah, Obal, Abimael, Sheba, Ophir, Havilah, and Jobab.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-008</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Babel">
  <data key="d0">Babel</data>
  <data key="d1">location</data>
  <data key="d2">Babel is identified as the beginning of Nimrod's kingdom and as the city whose name is associated with the confounding of language.&lt;SEP&gt;The city whose name commemorated the LORD’s confounding of the language of the earth.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-008&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-009</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Erech">
  <data key="d0">Erech</data>
  <data key="d1">location</data>
  <data key="d2">Erech is identified as one of the cities in the beginning of Nimrod's kingdom.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-008</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Accad">
  <data key="d0">Accad</data>
  <data key="d1">location</data>
  <data key="d2">Accad is identified as one of the cities in the beginning of Nimrod's kingdom.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-008</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Calneh">
  <data key="d0">Calneh</data>
  <data key="d1">location</data>
  <data key="d2">Calneh is identified as one of the cities in the beginning of Nimrod's kingdom.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-008</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Shinar">
  <data key="d0">Shinar</data>
  <data key="d1">location</data>
  <data key="d2">Shinar is the land containing the plain where people dwelt and attempted to build a city and tower.&lt;SEP&gt;The territory ruled by Amraphel.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-008&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-011</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Nineveh">
  <data key="d0">Nineveh</data>
  <data key="d1">location</data>
  <data key="d2">Nineveh is a city built by Asshur and is described as a great city in relation to Resen.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-008</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Rehoboth">
  <data key="d0">Rehoboth</data>
  <data key="d1">location</data>
  <data key="d2">Rehoboth is identified as a city built by Asshur.&lt;SEP&gt;Rehoboth is the name Isaac gave to a well where no dispute occurred, attributing the available space to the LORD.&lt;SEP&gt;A well over which people did not strive, named Rehoboth by Isaac.&lt;SEP&gt;Rehoboth by the river was the place associated with Saul.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-008&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-024&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-025&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-038</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Calah">
  <data key="d0">Calah</data>
  <data key="d1">location</data>
  <data key="d2">Calah is identified as a city built by Asshur and as a city near Resen.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-008</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Resen">
  <data key="d0">Resen</data>
  <data key="d1">location</data>
  <data key="d2">Resen is identified as a city located between Nineveh and Calah and described as a great city.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-008</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Gerar">
  <data key="d0">Gerar</data>
  <data key="d1">location</data>
  <data key="d2">Gerar is identified as a point in the border of the Canaanites.&lt;SEP&gt;Gerar is the place where Abraham sojourns and where Abimelech rules as king.&lt;SEP&gt;Gerar is the place where Isaac dwelt under Abimelech's rule and later pitched his tent in the surrounding valley.&lt;SEP&gt;The place from which Abimelech came to visit Isaac.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-008&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-017&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-024&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-025</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Gaza">
  <data key="d0">Gaza</data>
  <data key="d1">location</data>
  <data key="d2">Gaza is identified as a point in the border of the Canaanites.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-008</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Sodom">
  <data key="d0">Sodom</data>
  <data key="d1">location</data>
  <data key="d2">Sodom is identified as a point in the border of the Canaanites.&lt;SEP&gt;A city toward which Lot pitches his tent, whose inhabitants are described as exceedingly wicked and sinful.&lt;SEP&gt;A city ruled by Bera whose goods were taken and whose king fled during the battle in the vale of Siddim.&lt;SEP&gt;The city toward which the three men look and whose great cry and grievous sin prompt God's investigation.&lt;SEP&gt;Sodom is the city whose grievous sin prompts investigation and whose destruction is announced.&lt;SEP&gt;Sodom is one of the cities destroyed by the LORD with brimstone and fire.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-008&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-010&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-011&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-014&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-015&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-016</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Gomorrah">
  <data key="d0">Gomorrah</data>
  <data key="d1">location</data>
  <data key="d2">Gomorrah is identified as a point in the border of the Canaanites.&lt;SEP&gt;A city mentioned alongside Sodom as having been destroyed by the LORD.&lt;SEP&gt;A city ruled by Birsha whose goods were taken and whose king fled during the battle in the vale of Siddim.&lt;SEP&gt;The city associated with Sodom in the report of grievous sin that prompts God's investigation.&lt;SEP&gt;Gomorrah is associated with a great cry and grievous sin alongside Sodom.&lt;SEP&gt;Gomorrah is one of the cities destroyed by the LORD with brimstone and fire.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-008&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-010&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-011&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-014&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-015&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-016</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Admah">
  <data key="d0">Admah</data>
  <data key="d1">location</data>
  <data key="d2">Admah is identified as a point in the border of the Canaanites.&lt;SEP&gt;A city ruled by Shinab that joined the battle in the vale of Siddim.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-008&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-011</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Zeboim">
  <data key="d0">Zeboim</data>
  <data key="d1">location</data>
  <data key="d2">Zeboim is identified as a point in the border of the Canaanites.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-008</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Lasha">
  <data key="d0">Lasha</data>
  <data key="d1">location</data>
  <data key="d2">Lasha is identified as the endpoint of the stated border of the Canaanites.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-008</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Elam">
  <data key="d0">Elam</data>
  <data key="d1">person</data>
  <data key="d2">Elam is identified as one of the children of Shem.&lt;SEP&gt;The territory ruled by Chedorlaomer.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-008&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-011</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Aram">
  <data key="d0">Aram</data>
  <data key="d1">person</data>
  <data key="d2">Aram is identified as one of the children of Shem and the father of Uz, Hul, Gether, and Mash.&lt;SEP&gt;Aram was the child of Kemuel.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-008&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-019</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Uz">
  <data key="d0">Uz</data>
  <data key="d1">location</data>
  <data key="d2">Uz is identified as a child of Aram.&lt;SEP&gt;Uz is a child of Dishan.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-008&lt;SEP&gt;doc-a32a41554714252668fa190ace9e2f6c-chunk-037</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Tower">
  <data key="d0">Tower</data>
  <data key="d1">artifact</data>
  <data key="d2">The tower is a structure that the people in Shinar attempted to build with its top reaching heaven.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-008</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Raamah">
  <data key="d0">Raamah</data>
  <data key="d1">person</data>
  <data key="d2">Raamah is identified as a son of Cush and the father of Sheba and Dedan.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-008</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Sabtechah">
  <data key="d0">Sabtechah</data>
