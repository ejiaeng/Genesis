  <data key="d2">Ludim is identified as a child of Mizraim.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-008</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Anamim">
  <data key="d0">Anamim</data>
  <data key="d1">person</data>
  <data key="d2">Anamim is identified as a child of Mizraim.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-008</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
<node id="Lehabim">
  <data key="d0">Lehabim</data>
  <data key="d1">person</data>
  <data key="d2">Lehabim is identified as a child of Mizraim.</data>
