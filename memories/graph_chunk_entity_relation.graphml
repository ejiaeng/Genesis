  <data key="d0">Covering Of The Ark</data>
  <data key="d1">artifact</data>
  <data key="d2">The covering of the ark was removed by Noah after the waters had dried from the earth.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-006</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121368</data>
  <data key="d6"></data>
</node>
