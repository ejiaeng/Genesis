  <data key="d6"></data>
</node>
<node id="Weapons">
  <data key="d0">Weapons</data>
  <data key="d1">artifact</data>
  <data key="d2">Equipment Isaac instructed Esau to take into the field while hunting.</data>
  <data key="d3">doc-a32a41554714252668fa190ace9e2f6c-chunk-025</data>
  <data key="d4">Book 01        Genesis.md</data>
  <data key="d5">1790121384</data>
