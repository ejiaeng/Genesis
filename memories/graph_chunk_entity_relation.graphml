  <data key="d13"></data>
</edge>
<edge source="Abram" target="Haran (Location)">
  <data key="d7">1.0</data>
  <data key="d8">Abram departed from Haran after the LORD commanded Abram to leave.</data>
  <data key="d9">departure,travel</data>
  <data key="d10">doc-a32a41554714252668fa190ace9e2f6c-chunk-009</data>
