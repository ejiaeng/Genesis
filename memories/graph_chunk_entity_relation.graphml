<node id="Bela">
  <data key="d0">Bela</data>
  <data key="d1">person</data>
  <data key="d2">Bela is the son of Beor and the first named king to reign in Edom.&lt;SEP&gt;Bela was a ruler who died before Jobab succeeded him.</data>
